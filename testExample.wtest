import recursos.*
import granjeros.*
import clientes.*
import cooperativa.*

describe "Tests de La Granja Wollok" {
  test "Una vaca hambrienta produce 15 unidades y no es apta para exportación" {
    vaca.darHambre()
    assert.equals(15, vaca.unidades())
    assert.notThat(vaca.esAptoExportacion())
  }
  
  test "La gallina con espinacas y clima templado produce 22 unidades" {
    clima.seTempla()
    gallina.cambiarAlimento(espinacas)
    assert.equals(22, gallina.unidades())
  }
  
  test "Ana vende el manzano a Ricardo con clima frío y cobra 20" {
    clima.llegaElFrio()
    ana.trabajar(manzano)
    ana.venderA(ricardo)
    assert.equals(20, ana.dinero())
  }
  
  test "Carlos adquiere el manzano: sube su recargo a 40 y lo tiene en gestión" {
    carlos.adquirir(manzano)
    clima.llegaElFrio()
    carlos.trabajar(manzano)
    carlos.venderA(mateo)
    assert.equals(40, carlos.dinero())
  }
  
test "con clima frio, carlos adquiere manzano, jornada con vaca y manzano, feria agricola, trabajadora rural del manzano es ana" {
    clima.llegaElFrio()
    carlos.adquirir(manzano)
    cooperativa.jornadaLaboral(vaca, manzano)
    cooperativa.feriaAgricola()
    assert.equals(ana, cooperativa.trabajadorRural(manzano))
}
  
  test "El balance de granjeros que tienen la vaca refleja solo el dinero de Carlos" {
    vaca.saciar()
    clima.llegaElFrio()
    carlos.trabajar(vaca)
    carlos.venderA(mateo)
    assert.equals(50, cooperativa.balance(vaca))
  }
}